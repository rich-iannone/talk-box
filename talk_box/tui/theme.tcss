/* Talk Box TUI Theme
 *
 * Design tokens that carry to the desktop app (Phase 8).
 * Textual CSS — see https://textual.textualize.io/css_types/
 */

/* -- Persona category colors ---------------------------------------------- */
/* Used in persona browser badges and profile indicators */
/* $technical: #00bcd4; */
/* $data: #4caf50; */
/* $business: #ff9800; */
/* $creative: #e91e63; */
/* $education: #9c27b0; */

/* -- Freshness indicators ------------------------------------------------- */
/* $fresh: #4caf50; */
/* $aging: #ff9800; */
/* $stale: #f44336; */

/* -- Eval score colors ---------------------------------------------------- */
/* $score_high: #4caf50; */
/* $score_mid: #ff9800; */
/* $score_low: #f44336; */


/* -- Screen layout -------------------------------------------------------- */

Screen {
    layout: vertical;
}

#screen-container {
    height: 1fr;
}

#placeholder {
    padding: 2 4;
    text-align: center;
    width: 60;
}

/* -- Welcome screen ------------------------------------------------------- */

/* -- Home screen ---------------------------------------------------------- */

#home-layout {
    height: 1fr;
}

#home-left {
    width: 1fr;
    padding: 1 2;
}

#home-right {
    width: 1fr;
    padding: 1 2;
    border-left: solid $primary;
}

.home-panel {
    border: solid $primary;
    padding: 1 2;
    margin: 0 0 1 0;
}

#home-profile-title,
#home-nav-title,
#home-status-title {
    text-style: bold;
    padding: 0 0 1 0;
}

.home-nav-row {
    height: auto;
    padding: 0;
}

#home-sessions-header {
    height: auto;
    width: 100%;
    padding: 0 0 0 0;
}

#home-sessions-title {
    width: 1fr;
    padding: 0;
}

#home-sessions-view-all {
    width: auto;
    padding: 0;
    color: $accent;
    text-align: right;
}

#home-new-chat {
    width: 100%;
    margin: 1 0;
}

.home-session-tile {
    padding: 1 2;
    margin: 0 0 1 0;
    border: solid $primary;
    height: auto;
    width: 100%;
}

.home-session-tile:hover {
    border: solid $accent;
    background: $primary 15%;
}

#home-sessions-empty {
    padding: 1 2;
    color: $text-muted;
}


/* -- Sessions screen ------------------------------------------------------ */

#sessions-layout {
    height: 1fr;
}

#sessions-left {
    width: 2fr;
    padding: 1 2;
}

#sessions-right {
    width: 1fr;
    padding: 1 2;
    border-left: solid $primary;
}

#sessions-title {
    padding: 0 0 1 0;
}

#sessions-detail-title {
    padding: 0 0 1 0;
}

#sessions-detail-scroll {
    height: 1fr;
}

#sessions-detail-content {
    padding: 1 0;
}

#sessions-table {
    height: 1fr;
}

/* -- Chat screen ---------------------------------------------------------- */

#chat-layout {
    height: 1fr;
}

#chat-back-btn {
    width: auto;
    min-width: 8;
    height: 1;
    margin: 0 0 0 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $text-muted;
}

#chat-back-btn:hover {
    color: $text;
}

#chat-main {
    width: 3fr;
}

#chat-messages {
    height: 1fr;
    padding: 1 2;
}

.chat-message {
    padding: 1 2;
    margin: 0 0 1 0;
    width: 1fr;
}

.chat-msg-row {
    height: auto;
    width: 100%;
}

.chat-copy-btn {
    width: 4;
    min-width: 4;
    height: 3;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
}

.chat-copy-btn:hover {
    background: $surface;
    color: $text;
}

.chat-user {
    background: $primary 15%;
    border-left: thick $primary;
}

.chat-assistant {
    background: $surface;
    border-left: thick $secondary;
}

.chat-thinking {
    color: $text-muted;
}

.chat-system {
    background: $surface;
    border-left: thick $warning;
    padding: 1 2;
    margin: 0 4 1 0;
    color: $text-muted;
}

#chat-input-bar {
    dock: bottom;
    height: auto;
    min-height: 3;
    max-height: 10;
    margin: 0 1 0 1;
}

#chat-input {
    width: 1fr;
}

#chat-input-buttons {
    width: auto;
    height: auto;
    padding: 0 0 0 1;
}

#chat-send-btn {
    min-width: 10;
    margin: 0;
}

#chat-enter-toggle {
    min-width: 12;
    margin: 1 0 0 0;
}

#chat-sidebar {
    width: 34;
    border-left: solid $primary;
    padding: 1 1;
}

#chat-sidebar-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#chat-welcome-hint {
    padding: 2 4;
    text-align: center;
}

#chat-model-label,
#chat-persona-label {
    text-style: bold;
    padding: 1 0 0 0;
}

#chat-model-select,
#chat-persona-select {
    width: 100%;
    margin: 0 0 0 0;
}

/* -- Workspace screen ----------------------------------------------------- */

#workspace-layout {
    height: 1fr;
}

#workspace-tree-panel {
    width: 24;
    border-right: solid $primary;
    padding: 0 1;
}

#workspace-tree-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#workspace-tree {
    height: 1fr;
}

#workspace-modified-list {
    height: auto;
    max-height: 6;
    color: $warning;
    padding: 1 0 0 0;
}

#workspace-viewer-panel {
    width: 1fr;
}

#workspace-viewer-title {
    text-style: bold;
    padding: 0 1;
}

#workspace-viewer-scroll {
    height: 1fr;
    padding: 0 2;
}

#workspace-approval-bar {
    height: 3;
    padding: 0 1;
    dock: bottom;
}

#workspace-approval-bar.hidden {
    display: none;
}

#workspace-approval-bar Button {
    margin: 0 1 0 0;
    min-width: 10;
}

#workspace-change-info {
    width: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#workspace-agent-panel {
    width: 24;
    border-left: solid $primary;
    padding: 0 1;
}

#workspace-agent-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#workspace-agent-status {
    height: auto;
    padding: 0 0 1 0;
}

#workspace-plan-title {
    text-style: bold;
    padding: 1 0 0 0;
    border-top: solid $primary;
}

#workspace-plan-scroll {
    height: 1fr;
    padding: 0;
}

#workspace-agent-stats {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

#workspace-input {
    dock: bottom;
    margin: 0 1 0 1;
}

/* -- Model Browser screen ------------------------------------------------- */

#model-layout {
    padding: 1 2;
}

#model-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#model-table {
    height: 1fr;
    margin: 0 0 1 0;
}

#model-detail-panel {
    height: auto;
    max-height: 12;
    border: solid $primary;
    padding: 1 2;
}

/* -- Persona Browser screen ----------------------------------------------- */

#persona-layout {
    height: 1fr;
}

#persona-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#persona-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#persona-list {
    height: 1fr;
}

#persona-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#persona-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#persona-detail-scroll {
    height: 1fr;
}

#persona-use-btn {
    dock: bottom;
    margin: 1 0 0 0;
    width: 100%;
}

#model-use-btn {
    dock: bottom;
    margin: 1 0 0 0;
    width: 100%;
}

#profile-use-btn {
    dock: bottom;
    margin: 1 0 0 0;
    width: 100%;
}

/* -- Command list modal --------------------------------------------------- */

CommandListScreen {
    align: center middle;
}

/* -- Screen info modal ---------------------------------------------------- */

ScreenInfoModal {
    align: center middle;
}

#screen-info-panel {
    width: 60;
    max-height: 20;
    padding: 2 3;
    border: solid $accent;
    background: $surface;
}

#screen-info-text {
    padding: 0 1;
}

#command-list-panel {
    width: 40;
    max-height: 24;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}

#command-list {
    padding: 0 1;
}

/* -- File Approval Modal ------------------------------------------------- */

FileApprovalScreen {
    align: center middle;
}

#file-approval-panel {
    width: 80;
    max-height: 36;
    padding: 1 2;
    border: solid $warning;
    background: $surface;
}

#file-approval-title {
    padding: 0 1 1 1;
    text-style: bold;
}

#file-approval-preview {
    max-height: 24;
    overflow-y: auto;
    padding: 1;
    border: solid $primary-lighten-3;
    background: $surface-darken-1;
    margin: 0 1;
}

#file-approval-buttons {
    align: center middle;
    padding: 1 0 0 0;
    height: auto;
}

#file-approval-buttons Button {
    margin: 0 1;
}

#file-approval-nav {
    text-align: center;
    padding: 1 0 0 0;
}

/* -- Checklist Picker Modal ---------------------------------------------- */

ChecklistPickerModal {
    align: center middle;
}

#checklist-panel {
    width: 60;
    max-height: 30;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}

#checklist-title {
    padding: 0 1 1 1;
    text-style: bold;
}

#checklist-body {
    max-height: 20;
    padding: 0 1;
}

.checklist-item {
    height: 1;
    width: 100%;
}

.checklist-item:hover {
    background: $primary 20%;
}

#checklist-buttons {
    align: center middle;
    padding: 1 0 0 0;
    height: auto;
}

#checklist-buttons Button {
    margin: 0 1;
}

/* -- Session History Modal ----------------------------------------------- */

SessionHistoryModal {
    align: center middle;
}

#session-history-panel {
    width: 70;
    max-height: 30;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}

#session-history-title {
    padding: 0 1 1 1;
    text-style: bold;
}

#session-history-body {
    max-height: 20;
    padding: 0 1;
}

.session-item {
    height: 1;
    width: 100%;
}

.session-item:hover {
    background: $primary 20%;
}

#session-history-buttons {
    align: center middle;
    padding: 1 0 0 0;
    height: auto;
}

#session-history-buttons Button {
    margin: 0 1;
}

/* -- Welcome screen content ----------------------------------------------- */

#welcome-panel {
    width: 64;
    padding: 2 4;
    align: center middle;
}

#welcome-title {
    text-align: center;
    padding: 1 0;
    text-style: bold;
}

#welcome-subtitle {
    text-align: center;
    padding: 0 0 1 0;
    color: $text-muted;
}

#welcome-env {
    padding: 1 2;
    margin: 1 0;
    border: solid $primary;
}

#welcome-start {
    width: 100%;
    margin: 1 0 0 0;
}

#welcome-skip {
    width: 100%;
    margin: 0 0 1 0;
}

/* -- Profile Browser screen ----------------------------------------------- */

#profile-layout {
    height: 1fr;
}

#profile-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#profile-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#profile-list-scroll {
    height: 1fr;
}

#profile-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#profile-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

/* -- Guardrail Browser screen --------------------------------------------- */

#guard-layout {
    padding: 1 2;
}

#guard-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#guard-table {
    height: 1fr;
    margin: 0 0 1 0;
}

#guard-actions {
    height: auto;
    dock: bottom;
    padding: 0 0 1 0;
}

#guard-toggle-btn {
    min-width: 16;
}

#guard-detail-panel {
    height: auto;
    max-height: 10;
    border: solid $primary;
    padding: 1 2;
}

/* -- Trait Browser screen ------------------------------------------------- */

#trait-layout {
    height: 1fr;
}

#trait-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#trait-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#trait-list {
    height: 1fr;
}

#trait-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#trait-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#trait-detail-scroll {
    height: 1fr;
}

/* -- Pathway screen ------------------------------------------------------- */

#pathway-layout {
    padding: 1 2;
}

#pathway-info {
    padding: 1 2;
}

/* -- Skill Browser screen ------------------------------------------------- */

#skill-layout {
    height: 1fr;
}

#skill-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#skill-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#skill-list {
    height: 1fr;
}

#skill-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#skill-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#skill-detail-scroll {
    height: 1fr;
}

/* -- Knowledge Graph screen ----------------------------------------------- */

#kg-layout {
    padding: 1 2;
}

#kg-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#kg-stats {
    height: auto;
    padding: 0 0 1 0;
}

#kg-table {
    height: 1fr;
}

#kg-detail-scroll {
    height: auto;
    max-height: 12;
    padding: 1 0 0 0;
}

#kg-detail {
    padding: 0 1;
}

/* -- Memory Inspector screen ---------------------------------------------- */

#memory-layout {
    padding: 1 2;
}

#memory-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#memory-content {
    height: 1fr;
}

/* -- Eval Dashboard screen ------------------------------------------------ */

#eval-layout {
    padding: 1 2;
}

#eval-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#eval-dim-table {
    height: 1fr;
    margin: 0 0 1 0;
}

#eval-info-panel {
    height: auto;
    max-height: 8;
    border: solid $primary;
    padding: 1 2;
}

#eval-history-title {
    text-style: bold;
    padding: 1 0 0 0;
}

#eval-history-table {
    height: auto;
    max-height: 12;
    margin: 0 0 1 0;
}
