/* Talk Box TUI Theme
 *
 * Design tokens that carry to the desktop app (Phase 8).
 * Textual CSS — see https://textual.textualize.io/css_types/
 */

/* -- Persona category colors ---------------------------------------------- */
/* Used in persona browser badges and profile indicators */
/* $technical: #00bcd4; */
/* $data: #4caf50; */
/* $business: #ff9800; */
/* $creative: #e91e63; */
/* $education: #9c27b0; */

/* -- Freshness indicators ------------------------------------------------- */
/* $fresh: #4caf50; */
/* $aging: #ff9800; */
/* $stale: #f44336; */

/* -- Eval score colors ---------------------------------------------------- */
/* $score_high: #4caf50; */
/* $score_mid: #ff9800; */
/* $score_low: #f44336; */


/* -- Screen layout -------------------------------------------------------- */

Screen {
    layout: vertical;
}

#screen-container {
    height: 1fr;
}

#placeholder {
    padding: 2 4;
    text-align: center;
    width: 60;
}

/* -- Welcome screen ------------------------------------------------------- */

/* -- Home screen ---------------------------------------------------------- */

#home-scroll {
    padding: 1 2;
}

.home-panel {
    border: solid $primary;
    padding: 1 2;
    margin: 0 0 1 0;
}

#home-profile-panel {
    max-width: 72;
}

#home-profile-title,
#home-actions-title,
#home-status-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#home-columns {
    height: auto;
    max-width: 72;
}

#home-actions-panel {
    width: 1fr;
    margin-right: 1;
}

#home-actions-panel Button {
    width: 100%;
    margin: 0 0 1 0;
}

#home-status-panel {
    width: 1fr;
}

/* -- Chat screen ---------------------------------------------------------- */

#chat-layout {
    height: 1fr;
}

#chat-main {
    width: 3fr;
}

#chat-messages {
    height: 1fr;
    padding: 1 2;
}

.chat-message {
    padding: 1 2;
    margin: 0 0 1 0;
    width: 1fr;
}

.chat-msg-row {
    height: auto;
    width: 100%;
}

.chat-copy-btn {
    width: 4;
    min-width: 4;
    height: 3;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
}

.chat-copy-btn:hover {
    background: $surface;
    color: $text;
}

.chat-user {
    background: $primary 15%;
    border-left: thick $primary;
}

.chat-assistant {
    background: $surface;
    border-left: thick $secondary;
}

.chat-thinking {
    color: $text-muted;
}

.chat-system {
    background: $surface;
    border-left: thick $warning;
    padding: 1 2;
    margin: 0 4 1 0;
    color: $text-muted;
}

#chat-input {
    dock: bottom;
    margin: 0 1 0 1;
}

#chat-sidebar {
    width: 28;
    border-left: solid $primary;
    padding: 1 1;
}

#chat-sidebar-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#chat-welcome-hint {
    padding: 2 4;
    text-align: center;
}

#chat-model-label,
#chat-persona-label {
    text-style: bold;
    padding: 1 0 0 0;
}

#chat-model-select,
#chat-persona-select {
    width: 100%;
    margin: 0 0 0 0;
}

#chat-new-btn {
    width: 100%;
    margin: 1 0 0 0;
}

/* -- Workspace screen ----------------------------------------------------- */

#workspace-layout {
    height: 1fr;
}

#workspace-tree-panel {
    width: 24;
    border-right: solid $primary;
    padding: 0 1;
}

#workspace-tree-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#workspace-tree {
    height: 1fr;
}

#workspace-modified-list {
    height: auto;
    max-height: 6;
    color: $warning;
    padding: 1 0 0 0;
}

#workspace-viewer-panel {
    width: 1fr;
}

#workspace-viewer-title {
    text-style: bold;
    padding: 0 1;
}

#workspace-viewer-scroll {
    height: 1fr;
    padding: 0 2;
}

#workspace-approval-bar {
    height: 3;
    padding: 0 1;
    dock: bottom;
}

#workspace-approval-bar.hidden {
    display: none;
}

#workspace-approval-bar Button {
    margin: 0 1 0 0;
    min-width: 10;
}

#workspace-change-info {
    width: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#workspace-agent-panel {
    width: 24;
    border-left: solid $primary;
    padding: 0 1;
}

#workspace-agent-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#workspace-agent-status {
    height: auto;
    padding: 0 0 1 0;
}

#workspace-plan-title {
    text-style: bold;
    padding: 1 0 0 0;
    border-top: solid $primary;
}

#workspace-plan-scroll {
    height: 1fr;
    padding: 0;
}

#workspace-agent-stats {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

#workspace-input {
    dock: bottom;
    margin: 0 1 0 1;
}

/* -- Model Browser screen ------------------------------------------------- */

#model-layout {
    padding: 1 2;
}

#model-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#model-table {
    height: 1fr;
    margin: 0 0 1 0;
}

#model-detail-panel {
    height: auto;
    max-height: 12;
    border: solid $primary;
    padding: 1 2;
}

/* -- Persona Browser screen ----------------------------------------------- */

#persona-layout {
    height: 1fr;
}

#persona-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#persona-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#persona-list {
    height: 1fr;
}

#persona-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#persona-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#persona-detail-scroll {
    height: 1fr;
}

#persona-use-btn {
    dock: bottom;
    margin: 1 0 0 0;
    width: 100%;
}

#model-use-btn {
    dock: bottom;
    margin: 1 0 0 0;
    width: 100%;
}

#profile-use-btn {
    dock: bottom;
    margin: 1 0 0 0;
    width: 100%;
}

/* -- Command list modal --------------------------------------------------- */

CommandListScreen {
    align: center middle;
}

#command-list-panel {
    width: 40;
    max-height: 24;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}

#command-list {
    padding: 0 1;
}

/* -- Welcome screen content ----------------------------------------------- */

#welcome-panel {
    width: 64;
    padding: 2 4;
    align: center middle;
}

#welcome-title {
    text-align: center;
    padding: 1 0;
    text-style: bold;
}

#welcome-subtitle {
    text-align: center;
    padding: 0 0 1 0;
    color: $text-muted;
}

#welcome-env {
    padding: 1 2;
    margin: 1 0;
    border: solid $primary;
}

#welcome-start {
    width: 100%;
    margin: 1 0 0 0;
}

#welcome-skip {
    width: 100%;
    margin: 0 0 1 0;
}

/* -- Profile Browser screen ----------------------------------------------- */

#profile-layout {
    height: 1fr;
}

#profile-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#profile-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#profile-list-scroll {
    height: 1fr;
}

#profile-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#profile-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

/* -- Guardrail Browser screen --------------------------------------------- */

#guard-layout {
    padding: 1 2;
}

#guard-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#guard-table {
    height: 1fr;
    margin: 0 0 1 0;
}

#guard-detail-panel {
    height: auto;
    max-height: 10;
    border: solid $primary;
    padding: 1 2;
}

/* -- Trait Browser screen ------------------------------------------------- */

#trait-layout {
    height: 1fr;
}

#trait-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#trait-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#trait-list {
    height: 1fr;
}

#trait-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#trait-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#trait-detail-scroll {
    height: 1fr;
}

/* -- Pathway screen ------------------------------------------------------- */

#pathway-layout {
    padding: 1 2;
}

#pathway-info {
    padding: 1 2;
}

/* -- Skill Browser screen ------------------------------------------------- */

#skill-layout {
    height: 1fr;
}

#skill-list-panel {
    width: 30;
    border-right: solid $primary;
    padding: 1 1;
}

#skill-list-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#skill-list {
    height: 1fr;
}

#skill-detail-panel {
    width: 1fr;
    padding: 1 2;
}

#skill-detail-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#skill-detail-scroll {
    height: 1fr;
}

/* -- Knowledge Graph screen ----------------------------------------------- */

#kg-layout {
    padding: 1 2;
}

#kg-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#kg-stats {
    height: auto;
    padding: 0 0 1 0;
}

#kg-table {
    height: 1fr;
}

#kg-detail-scroll {
    height: auto;
    max-height: 12;
    padding: 1 0 0 0;
}

#kg-detail {
    padding: 0 1;
}

/* -- Memory Inspector screen ---------------------------------------------- */

#memory-layout {
    padding: 1 2;
}

#memory-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#memory-content {
    height: 1fr;
}

/* -- Eval Dashboard screen ------------------------------------------------ */

#eval-layout {
    padding: 1 2;
}

#eval-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#eval-dim-table {
    height: 1fr;
    margin: 0 0 1 0;
}

#eval-info-panel {
    height: auto;
    max-height: 8;
    border: solid $primary;
    padding: 1 2;
}
